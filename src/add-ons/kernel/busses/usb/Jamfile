SubDir HAIKU_TOP src add-ons kernel busses usb ;

SubDirC++Flags -fno-rtti ;

UsePrivateKernelHeaders ;
UsePrivateHeaders drivers ;
SubDirHdrs $(HAIKU_TOP) src add-ons kernel bus_managers acpi acpica include ;
SubDirHdrs $(HAIKU_TOP) src add-ons kernel bus_managers acpi acpica include platform ;
UseHeaders [ FDirName $(HAIKU_TOP) src add-ons kernel bus_managers usb ] ;

local xhciArchSources ;
if $(TARGET_ARCH) = riscv64 {
	xhciArchSources = xhci_jh7110.cpp ;
}

KernelAddon <usb>uhci :
	uhci.cpp
	uhci_rh.cpp
	: libusb.a
	: uhci.rdef
	;

KernelAddon <usb>ohci :
	ohci.cpp
	ohci_rh.cpp
	: libusb.a
	: ohci.rdef
	;

KernelAddon <usb>ehci :
	ehci.cpp
	ehci_rh.cpp
	: libusb.a
	: ehci.rdef
	;

KernelAddon <usb>xhci :
	xhci.cpp
	xhci_rh.cpp
	$(xhciArchSources)
	: libusb.a
	: xhci.rdef
	;

