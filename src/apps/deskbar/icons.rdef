
#include "icons.h"

// Deskbar menu logos in the style of the original BeOS wordmark: "BeOS" in
// the vertical, expanded layout and "Be" in every other layout.
//
// GetVectorIcon() scales the 64 x 64 icon canvas by the bitmap's width. Each
// logo therefore spans the canvas width and TBarMenuBar renders it at that
// logo's aspect ratio; the constants in BarMenuBar.cpp must match the drawn
// heights below (wordmark 19.11, mark 40.19 canvas units).
//
// The "Dark" versions are for dark menus: the same artwork with the BeOS blue
// (#1B3F8F) replaced by off-white (#EFE9DD), the first style in each icon.
