
#include "icons.h"

// Deskbar menu logos. TBarMenuBar shows the wordmark in the vertical,
// expanded layout and the mark in every other layout.
//
// GetVectorIcon() scales the 64 x 64 icon canvas by the bitmap's width, so
// each logo spans the full canvas width, and TBarMenuBar renders it at that
// logo's aspect ratio. Both were converted from their source SVGs:
//   wordmark: data/artwork/RenkuOS logo - deskbar.svg (aspect 4.738)
//   mark:     data/artwork/RenkuOS logo - mark.svg (aspect 1.831), the three
//             dots of data/artwork/RenkuOS logo.svg
