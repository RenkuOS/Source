#
# Spritz Depot, a third-party catalog of Haiku applications. It is configured
# by default so that community packages can be found without hunting for a
# repository URL; see RenkuOS/Source#95.
#
# The file is named after the repository's own name in its repo.info, which is
# what "pkgman add-repo" would create, so re-adding it replaces this file
# rather than duplicating it. The identifier must match the one in repo.info.
#
# The repository itself announces priority 1. It is lowered to 2 here, so a
# package that Renku or HaikuPorts also provides is always taken from them:
# Spritz adds packages, it never replaces system or HaikuPorts ones.

cfgversion=2

baseurl=https://spritzdepot.desktoponfire.com/repo/x86_64/current

identifier=e1ed6cac-63de-418d-ab36-01e452336d75

# a deprecated copy of the [identifier] key above for older os versions
url=e1ed6cac-63de-418d-ab36-01e452336d75

priority=2
